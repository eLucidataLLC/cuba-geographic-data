[
  {
    "field": "Hylak_id",
    "type": "integer",
    "description": "Original HydroLAKES water-body identifier.",
    "nullable": true
  },
  {
    "field": "id",
    "type": "string",
    "description": "UUIDv7 identifier of this object; existing generated IDs are preserved.",
    "nullable": false,
    "format": "uuid",
    "uuid_version": 7,
    "unique": true
  },
  {
    "field": "Poly_src",
    "type": "string",
    "description": "Dataset supplying the source outline.",
    "nullable": true,
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Lake_type",
    "type": "integer",
    "description": "Source category: 1 lake, 2 reservoir, 3 regulated lake. Default 1 does not establish natural origin.",
    "nullable": true,
    "allowed_values": {
      "1": "lake (source default)",
      "2": "reservoir",
      "3": "regulated lake"
    },
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Grand_id",
    "type": "integer",
    "description": "GRanD reservoir identifier; 0 means no linked record.",
    "nullable": true,
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Lake_area",
    "type": "number",
    "description": "Source water-surface area.",
    "nullable": true,
    "units": "km2",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Shore_len",
    "type": "number",
    "description": "Source shoreline length.",
    "nullable": true,
    "units": "km",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Shore_dev",
    "type": "number",
    "description": "Shoreline-to-equal-area-circle circumference ratio.",
    "nullable": true,
    "units": "dimensionless",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Vol_total",
    "type": "number",
    "description": "Total volume, reported or modeled according to Vol_src.",
    "nullable": true,
    "units": "million m3",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Vol_res",
    "type": "number",
    "description": "Reported reservoir storage; 0 indicates none.",
    "nullable": true,
    "units": "million m3",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Vol_src",
    "type": "integer",
    "description": "Volume provenance: 1 reported lake, 2 reported reservoir, 3 modeled lake.",
    "nullable": true,
    "allowed_values": {
      "1": "reported lake volume",
      "2": "reported reservoir volume",
      "3": "modeled lake volume"
    },
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Depth_avg",
    "type": "number",
    "description": "Mean depth derived from volume and surface area.",
    "nullable": true,
    "units": "m",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Dis_avg",
    "type": "number",
    "description": "Modeled long-term outlet flow; -9999 means unavailable.",
    "nullable": true,
    "units": "m3/s",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Res_time",
    "type": "number",
    "description": "Volume-to-flow residence estimate; -1 means zero flow, -9999 unavailable.",
    "nullable": true,
    "units": "days",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Elevation",
    "type": "integer",
    "description": "Source lake-surface elevation.",
    "nullable": true,
    "units": "m above sea level",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Slope_100",
    "type": "number",
    "description": "Mean surrounding slope within 100 m; -1 means uncalculated.",
    "nullable": true,
    "units": "degrees",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Wshd_area",
    "type": "number",
    "description": "Contributing area at outlet; -9999 means unavailable.",
    "nullable": true,
    "units": "km2",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Pour_long",
    "type": "number",
    "description": "Source outlet longitude.",
    "nullable": true,
    "units": "degrees east",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "Pour_lat",
    "type": "number",
    "description": "Source outlet latitude.",
    "nullable": true,
    "units": "degrees north",
    "definition_source": "https://data.hydrosheds.org/file/technical-documentation/HydroLAKES_TechDoc_v10.pdf"
  },
  {
    "field": "geometry",
    "type": "geometry",
    "description": "Spatial representation of this record; CRS and coverage are documented in metadata.xml.",
    "nullable": true,
    "geometry_types": [
      "MultiPolygon"
    ]
  },
  {
    "field": "gazetteer_id",
    "type": "string",
    "description": "UUIDv7 foreign key to water geographic names.id.",
    "nullable": true,
    "references": {
      "product": "water-geographic-names",
      "field": "id"
    }
  },
  {
    "field": "alternative_gazetteer_ids",
    "type": "string",
    "description": "JSON array of additional accepted name UUIDs on this geometry; all accepted names when no preferred name was selected.",
    "nullable": true
  },
  {
    "field": "naming_status",
    "type": "string",
    "description": "Recorded reach applicability status or accepted/not_applicable water-body association status.",
    "nullable": true
  },
  {
    "field": "geometry_repair_method",
    "type": "string",
    "description": "none for unchanged polygons; make_valid_linework_boundary_preserving reorganizes self-touching rings without changing coordinates, boundary point sets or polygon-part counts.",
    "nullable": true
  }
]
